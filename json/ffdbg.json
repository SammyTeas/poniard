                      "type": "button",
                      "props": {
                        "variant": "blurry"
                      },
                      "onClick": "game.data.GridControls.char0row = (game.data.GridControls.char0row || 0) - (game.data.GridControls.char0row > 0 ? 1 : 0); chatLog('moved character 1 up')",
                      "children": "\u25b2"
                    },
